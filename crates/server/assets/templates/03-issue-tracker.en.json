  "cards": [
    {
      "id": "ceb53077-29a3-5834-8dcb-cb3adff67eeb",
      "type": "card",
      "title": "The password reset mail arrives twice",
      "fields": {
        "icon": "📨",
        "isTemplate": false,
        "properties": {
          "41fb4307-4d35-515d-8f28-ee0bd207e0fd": "16f381d8-7af4-50a9-af83-f722169249ea",
          "d1dc2175-04b7-5afe-9ee0-c1e806659aaa": "6b41afa1-3697-5dd5-b3d3-0a91ca03bb4c",
          "9c1adb28-489c-5bb0-b0da-56ff86b55106": "31be07e5-e6a5-5f75-a98c-e2fd505bf4f1",
          "f7664802-8fcb-57c9-a358-3c839dbaa8d5": ["b6af3143-d64b-5425-863b-bc776cc46409"]
        }
      },
      "body": {
        "type": "doc",
        "content": [
          {
            "type": "heading",
            "attrs": {
              "level": 2
            },
            "content": [
              {
                "type": "text",
                "text": "Steps to reproduce"
              }
            ]
          },
          {
            "type": "orderedList",
            "attrs": {
              "start": 1
            },
            "content": [
              {
                "type": "listItem",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "Press “Forgot your password” on the sign-in screen"
                      }
                    ]
                  }
                ]
              },
              {
                "type": "listItem",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "Enter an address and press the button twice, quickly"
                      }
                    ]
                  }
                ]
              },
              {
                "type": "listItem",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "Look at the inbox"
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "type": "heading",
            "attrs": {
              "level": 2
            },
            "content": [
              {
                "type": "text",
                "text": "Expected and seen"
              }
            ]
          },
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Expected",
                "marks": [
                  {
                    "type": "bold"
                  }
                ]
              },
              {
                "type": "text",
                "text": ": one mail."
              },
              {
                "type": "hardBreak"
              },
              {
                "type": "text",
                "text": "Seen",
                "marks": [
                  {
                    "type": "bold"
                  }
                ]
              },
              {
                "type": "text",
                "text": ": two mails that say the same."
              }
            ]
          },
          {
            "type": "heading",
            "attrs": {
              "level": 2
            },
            "content": [
              {
                "type": "text",
                "text": "A guess"
              }
            ]
          },
          {
            "type": "codeBlock",
            "attrs": {
              "language": "typescript"
            },
            "content": [
              {
                "type": "text",
                "text": "// The button stays enabled while the request is on its way.\nbutton.disabled = false;\nawait send(address);"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "1b68f9cf-9835-5522-bf34-ba574d8b543d",
