[
 {
  "name": "list_tasks",
  "description": "List tasks using structured filters and sort. assigneeId may be me. Optional from/to (YYYY-MM-DD) filter by calendar overlap.",
  "inputSchema": {
   "type": "object",
   "properties": {
    "workspaceId": {
     "type": "string",
     "format": "uuid",
     "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "projectId": {
     "type": "string",
     "format": "uuid",
     "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "query": {
     "type": "object",
     "properties": {
      "filters": {
       "default": {},
       "type": "object",
       "properties": {
        "type": {
         "type": "string",
         "enum": [
          "task",
          "bug",
          "story",
          "epic",
          "subtask"
         ]
        },
        "statusId": {
         "type": "string",
         "format": "uuid",
         "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "assigneeId": {
         "anyOf": [
          {
           "type": "string",
           "format": "uuid",
           "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          {
           "type": "string",
           "const": "me"
          }
         ]
        },
        "priority": {
         "type": "string",
         "enum": [
          "none",
          "low",
          "medium",
          "high",
          "urgent"
         ]
        },
        "labelId": {
         "type": "string",
         "format": "uuid",
         "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "milestoneId": {
         "type": "string",
         "format": "uuid",
         "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "openOnly": {
         "type": "boolean"
        },
        "dueBefore": {
         "type": "string",
         "format": "date",
         "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        "title": {
         "type": "string",
         "minLength": 1,
         "maxLength": 1000
        },
        "custom": {
         "maxItems": 25,
         "type": "array",
         "items": {
          "oneOf": [
           {
            "type": "object",
            "properties": {
             "fieldId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
             },
             "operator": {
              "type": "string",
              "const": "equals"
             },
             "value": {
              "anyOf": [
               {
                "type": "string",
                "maxLength": 1000
               },
               {
                "type": "number"
               },
               {
                "type": "boolean"
               }
              ]
             }
            },
            "required": [
             "fieldId",
             "operator",
             "value"
            ],
            "additionalProperties": false
           },
           {
            "type": "object",
            "properties": {
             "fieldId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
             },
             "operator": {
              "type": "string",
              "const": "empty"
             }
            },
            "required": [
             "fieldId",
             "operator"
            ],
            "additionalProperties": false
           }
          ]
         }
        }
       },
       "additionalProperties": false
      },
      "sort": {
       "default": [],
       "maxItems": 3,
       "type": "array",
       "items": {
        "type": "object",
        "properties": {
         "field": {
          "anyOf": [
           {
            "type": "string",
            "enum": [
             "priority",
             "due",
             "updated",
             "created",
             "rank",
             "title",
             "status",
             "number"
            ]
           },
           {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
           }
          ]
         },
         "direction": {
          "type": "string",
          "enum": [
           "asc",
           "desc"
          ]
         }
        },
        "required": [
         "field",
         "direction"
        ],
        "additionalProperties": false
       }
      }
     },
     "additionalProperties": false
    },
    "archived": {
     "type": "boolean"
    },
    "cursor": {
     "type": "string",
     "maxLength": 1024
    },
    "limit": {
     "type": "integer",
     "minimum": 1,
     "maximum": 100
    },
    "from": {
     "type": "string",
     "format": "date",
     "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "to": {
     "type": "string",
     "format": "date",
     "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    }
   },
   "required": [
    "workspaceId",
    "projectId"
   ],
   "$schema": "http://json-schema.org/draft-07/schema#"
  },
  "execution": {
   "taskSupport": "forbidden"
  }
