# Copy to .env and replace placeholders before `docker compose up`.
# Never commit real secrets.

# PostgreSQL owner (migration role; not used for request handling).
POSTGRES_DB=fvoci
POSTGRES_USER=fvoci_owner
POSTGRES_PASSWORD=
# URL-safe characters only (used inside connection URLs), e.g. `openssl rand -hex 24`.

# Dedicated application LOGIN role (NOSUPERUSER, NOBYPASSRLS).
FVOCI_APP_ROLE=fvoci_app
FVOCI_APP_PASSWORD=

# Password pepper keyring (64-char hex per key): {"install":"<openssl rand -hex 32>"}.
# Keep it stable across restarts; the empty value makes compose refuse to start.
PASSWORD_PEPPER_KEYS=
PASSWORD_PEPPER_ACTIVE_KEY_ID=install

# Browser origin for mutating HTTP routes and /collab upgrade checks.
FVOCI_PUBLIC_ORIGIN=http://127.0.0.1:8080
FVOCI_COOKIE_SECURE=false

# Host address/port to publish; must match FVOCI_PUBLIC_ORIGIN above.
# Put a TLS reverse proxy in front and set FVOCI_PUBLIC_ORIGIN=https://... and
# FVOCI_COOKIE_SECURE=true for anything beyond local evaluation.
FVOCI_PUBLISH_ADDR=127.0.0.1
FVOCI_PUBLISH_PORT=8080

# Meilisearch CE master key (>= 16 chars). The server never receives this;
# init writes a scoped API key to /run/fvoci/meili/api_key.
MEILI_MASTER_KEY=

# Outgoing mail (all three or none). Unset disables mail; invitation links are
# shown in the UI instead. STARTTLS is used when the relay offers it.
SMTP_HOST=
SMTP_PORT=
SMTP_FROM=

# Optional: key ring that seals workspace webhook secrets at rest
# ({"install":"<openssl rand -hex 32>"}). Unset disables webhook creation.
# Keep it with the database backup; sealed secrets cannot be opened without it.
ENCRYPTION_KEYS=
ENCRYPTION_ACTIVE_KEY_ID=

# Optional GitHub App (all three or none). The private key may be one line
# with literal \n separators.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# Install-state MAC key (>= 32 bytes, e.g. openssl rand -hex 32). Optional when
# ENCRYPTION_KEYS is set (then derived from its active key).
GITHUB_STATE_SECRET=

# Optional document AI actions (local text heuristics, no external model).
FVOCI_AI_ENABLED=
FVOCI_AI_SECRET=
# Optional semantic search: OpenAI-compatible embeddings endpoint (RUNNING.md).
FVOCI_AI_EMBEDDINGS_BASE_URL=
FVOCI_AI_EMBEDDINGS_MODEL=
FVOCI_AI_EMBEDDINGS_ALLOW_PRIVATE=

# Built locally by scripts/install-smoke.sh or your own `docker build`.
FVOCI_IMAGE=fvoci-rust-install:local

# Optional S3-compatible attachment storage (omit to keep FVOCI_STORAGE_DIR local).
# Used only with `-f infra/rust/compose.s3.yml`. Never commit real credentials.
# STORAGE_DRIVER=s3
# S3_ENDPOINT=http://silo:9000
# S3_REGION=us-east-1
# S3_BUCKET=fvoci
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=1
# S3_PUBLIC_ENDPOINT=
# UPLOAD_INCOMPLETE_TTL_HOURS=24
