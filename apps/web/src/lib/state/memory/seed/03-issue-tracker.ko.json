  "cards": [
    {
      "id": "ceb53077-29a3-5834-8dcb-cb3adff67eeb",
      "type": "card",
      "title": "비밀번호 재설정 메일이 두 번 온다",
      "fields": {
        "icon": "📨",
        "isTemplate": false,
        "properties": {
          "41fb4307-4d35-515d-8f28-ee0bd207e0fd": "16f381d8-7af4-50a9-af83-f722169249ea",
          "d1dc2175-04b7-5afe-9ee0-c1e806659aaa": "6b41afa1-3697-5dd5-b3d3-0a91ca03bb4c",
          "9c1adb28-489c-5bb0-b0da-56ff86b55106": "31be07e5-e6a5-5f75-a98c-e2fd505bf4f1",
          "f7664802-8fcb-57c9-a358-3c839dbaa8d5": ["b6af3143-d64b-5425-863b-bc776cc46409"]
        }
      },
      "body": {
        "type": "doc",
        "content": [
          {
            "type": "heading",
            "attrs": {
              "level": 2
            },
            "content": [
              {
                "type": "text",
                "text": "다시 내는 방법"
              }
            ]
          },
          {
            "type": "orderedList",
            "attrs": {
              "start": 1
            },
            "content": [
              {
                "type": "listItem",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "로그인 화면에서 ‘비밀번호를 잊었나요’를 누른다"
                      }
                    ]
                  }
                ]
              },
              {
                "type": "listItem",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "주소를 넣고 단추를 빠르게 두 번 누른다"
                      }
                    ]
                  }
                ]
              },
              {
                "type": "listItem",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "메일함을 본다"
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "type": "heading",
            "attrs": {
              "level": 2
            },
            "content": [
              {
                "type": "text",
                "text": "기대한 것과 본 것"
              }
            ]
          },
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "기대",
                "marks": [
                  {
                    "type": "bold"
                  }
                ]
              },
              {
                "type": "text",
                "text": ": 메일 한 통."
              },
              {
                "type": "hardBreak"
              },
              {
                "type": "text",
                "text": "실제",
                "marks": [
                  {
                    "type": "bold"
                  }
                ]
              },
              {
                "type": "text",
                "text": ": 내용이 같은 메일 두 통."
              }
            ]
          },
          {
            "type": "heading",
            "attrs": {
              "level": 2
            },
            "content": [
              {
                "type": "text",
                "text": "짚이는 곳"
              }
            ]
          },
          {
            "type": "codeBlock",
            "attrs": {
              "language": "typescript"
            },
            "content": [
              {
                "type": "text",
                "text": "// The button stays enabled while the request is on its way.\nbutton.disabled = false;\nawait send(address);"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "1b68f9cf-9835-5522-bf34-ba574d8b543d",
      "type": "card",
      "title": "내보낸 내역의 합계가 화면과 다르다",
      "fields": {
        "icon": "🧾",
        "isTemplate": false,
        "properties": {
          "41fb4307-4d35-515d-8f28-ee0bd207e0fd": "7ed17f61-04fa-59ec-b47a-bc83c17463d0",
          "d1dc2175-04b7-5afe-9ee0-c1e806659aaa": "6b41afa1-3697-5dd5-b3d3-0a91ca03bb4c",
          "9c1adb28-489c-5bb0-b0da-56ff86b55106": "0c3a80e9-0da4-526e-9eb3-8b3994a5584e",
          "f7664802-8fcb-57c9-a358-3c839dbaa8d5": ["633c044a-7e58-5e08-9f63-86101a98359e"]
        }
      },
      "body": {
        "type": "doc",
        "content": [
          {
            "type": "blockquote",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "지난달 합계가 화면에는 1,204,000원인데 내보낸 파일에는 1,194,000원입니다."
                  }
                ]
              }
            ]
          },
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "환불 한 건이 파일에만 빠져 있습니다. 화면이 맞습니다."
              }
            ]
          }
        ]
      }
    },
    {
