            "07ceb846-e0bc-58a0-8ca0-82b572209906"
          ],
          "d4ab6f2d-8f17-5bef-a690-13b90b012af4": {
            "from": "2026-12-02"
          },
          "0f964d15-cac0-523c-b2af-fad9f295efed": "https://example.com/blog/plan-a-week"
        }
      },
      "body": {
        "type": "doc",
        "content": [
          {
            "type": "image",
            "attrs": {
              "fileId": "board.png",
              "alt": "A board of three columns with cards in them"
            }
          },
          {
            "type": "heading",
            "attrs": {
              "level": 2
            },
            "content": [
              {
                "type": "text",
                "text": "Outline"
              }
            ]
          },
          {
            "type": "orderedList",
            "attrs": {
              "start": 1
            },
            "content": [
              {
                "type": "listItem",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "On Monday, write everything down as cards"
                      }
                    ]
                  }
                ]
              },
              {
                "type": "listItem",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "Move three a day to “Today”"
                      }
                    ]
                  }
                ]
              },
              {
                "type": "listItem",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "On Friday, look back at what is left"
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "type": "blockquote",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Write it all down and your head is lighter."
                  }
                ]
              }
            ]
          }
        ]
      }
    },
