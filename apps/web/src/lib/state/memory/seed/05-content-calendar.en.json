    {
      "id": "1a08f0e3-8816-5fb7-8610-d681645fdb94",
      "type": "card",
      "title": "How to plan a week on a board",
      "fields": {
        "icon": "🗂️",
        "isTemplate": false,
        "properties": {
          "70a23d2c-c625-5914-bf38-2b743dbe75d0": "9fbe9f25-85b1-5b41-8ce0-0d26f659836d",
