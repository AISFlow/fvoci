# The web app formats everything with two spaces. This file is where the
# search for settings stops: Prettier and editors read nothing above it.
root = true

[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8
indent_style = space
indent_size = 2

[src/lib/{ui,hooks}/**]
indent_style = tab
