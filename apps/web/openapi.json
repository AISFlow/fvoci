  "components": {
    "schemas": {
      "AncestorResponse": {
        "type": "object",
        "required": [
          "id",
          "title",
          "icon",
          "path",
          "projectId",
          "number"
        ],
        "properties": {
          "icon": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "type": "string"
          },
          "number": {
            "type": "integer",
            "format": "int32"
          },
          "path": {
            "type": "string"
          },
          "projectId": {
            "type": [
              "string",
              "null"
            ]
          },
          "title": {
            "type": "string"
          }
        }
      },
      "AncestorsResponse": {
        "type": "object",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AncestorResponse"
            }
          }
        }
      },
      "BodyResponse": {
        "type": "object",
        "required": [
          "contentJson",
          "version"
        ],
        "properties": {
          "contentJson": {},
          "version": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "BrandingOutput": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          }
        }
      },
      "CreateDocumentBody": {
        "type": "object",
        "required": [
          "parentId",
          "title"
        ],
        "properties": {
          "icon": {
            "type": [
              "string",
              "null"
            ]
          },
          "parentId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "title": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "CreateWorkspaceBody": {
        "type": "object",
        "required": [
          "name",
          "slug"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "DocumentMetaResponse": {
        "type": "object",
        "required": [
          "id",
          "workspaceId",
          "title",
          "number",
          "icon",
          "path",
          "parentId",
          "sortKey",
          "projectId",
          "status",
          "schemaVersion",
          "version",
          "createdBy",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "createdBy": {
            "type": "string"
          },
          "displayId": {
            "type": "string"
          },
          "icon": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "type": "string"
          },
          "number": {
            "type": "integer",
            "format": "int32"
          },
          "parentId": {
            "type": [
              "string",
              "null"
            ]
          },
          "path": {
            "type": "string"
          },
          "projectId": {
            "type": [
              "string",
              "null"
            ]
          },
          "schemaVersion": {
            "type": "integer",
            "format": "int32"
          },
          "sortKey": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "version": {
            "type": "integer",
            "format": "int32"
          },
          "workspaceId": {
            "type": "string"
          }
        }
      },
      "LoginBody": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
