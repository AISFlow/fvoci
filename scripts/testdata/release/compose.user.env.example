# FVOCI settings. Copy to .env next to compose.yml and fill in every empty
# value; docker compose refuses to start while one is empty. Generate each
# secret once and keep .env with your backups: the database and all sign-ins
# depend on these values, and changing them later locks you out.

# Address users open (scheme://host[:port]) and the host port it maps to on
# 127.0.0.1. Change both together; for a domain or HTTPS see RUNNING.md "Install".
FVOCI_PUBLIC_ORIGIN=http://localhost:8080
FVOCI_PUBLISH_PORT=8080

# The three passwords and the two keyrings below reach the containers as
# root-only files (/run/secrets), not as environment; after changing one, run
# docker compose up -d --force-recreate.

# Database owner password (used only to prepare the database):
#   openssl rand -hex 32
POSTGRES_PASSWORD=

# Password of the restricted role the server uses; must differ from the above:
#   openssl rand -hex 32
FVOCI_APP_PASSWORD=

# Meilisearch master key (used only to create the server's search key):
#   openssl rand -hex 32
MEILI_MASTER_KEY=

# Password pepper keyring:
#   printf '{"install":"%s"}\n' "$(openssl rand -hex 32)"
PASSWORD_PEPPER_KEYS=
PASSWORD_PEPPER_ACTIVE_KEY_ID=install

# Encryption keyring for stored secrets (MFA, SSO, webhooks, push):
#   printf '{"install":"%s"}\n' "$(openssl rand -hex 32)"
ENCRYPTION_KEYS=
ENCRYPTION_ACTIVE_KEY_ID=install
