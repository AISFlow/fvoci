# The settings of docker/compose.yaml. Copy to docker/.env (never committed) and fill
# in every secret: compose refuses to start while one is missing, and a service whose
# secret is empty stops and names it.
# After an update, bring the lines this file has and yours lacks (compose names the
# first secret missing).

# Where fvoci is reachable on this machine, and the address people use (the reverse
# proxy's, https://..., in front of it).
FVOCI_BIND=127.0.0.1
FVOCI_HOST_PORT=8080
FVOCI_SERVER_URL=http://localhost:8080
# Addresses of that proxy, as fvoci sees them (10.0.0.0/8 or the like), comma-separated;
# behind the profile tunnel, the range of the network edge (compose.yaml says how).
FVOCI_TRUSTED_PROXIES=
# first_user_only: one organization; open: everyone who signs up starts one.
FVOCI_ORG_CREATION=first_user_only

# Secrets. Each one is made with the command after it.
# PostgreSQL's superuser, the owner of the tables, who makes
# fvoci's role and migrates (set when its volume is new; later
# change it with ALTER ROLE as well):                         openssl rand -hex 24
POSTGRES_PASSWORD=
# The PostgreSQL role fvoci, which only uses the tables (to
# change it, see "a changed secret" below):                   openssl rand -hex 24
FVOCI_DB_PASSWORD=
# The key fvoci seals stored secrets with (keep it: a new one
# loses the sign-in providers' secrets):                      openssl rand -base64 32
FVOCI_SECRET_KEY=
# The search server's user fvoci (to change it, see "a changed
# secret" below):                                             openssl rand -hex 24
FVOCI_SEARCH_PASSWORD=
# The bearer token of the metrics, served on the backend
# network as fvoci:9092/metrics:                              openssl rand -hex 32
FVOCI_METRICS_TOKEN=

# A changed secret reaches only a container made after the change: compose does not
# make them again for it. After changing FVOCI_DB_PASSWORD, FVOCI_SEARCH_PASSWORD or
# another secret of fvoci:
#   docker compose up -d --force-recreate fvoci search

# The search server's memory.
FVOCI_SEARCH_HEAP=-Xms512m -Xmx512m

# Profile s3 (`--profile s3`): files in SeaweedFS instead of the volume fvoci-data.
# FVOCI_FILE_STORAGE=s3
# FVOCI_FILE_STORAGE_S3_ENDPOINT=s3:8333
# FVOCI_FILE_STORAGE_S3_BUCKET=fvoci
# FVOCI_FILE_STORAGE_S3_REGION=us-east-1
# true for an endpoint over HTTPS (another S3-compatible store):
# FVOCI_FILE_STORAGE_S3_HTTPS=false
# The keys of the store's one identity (both empty without the profile):
#                                                             openssl rand -hex 16
FVOCI_S3_ACCESS_KEY_ID=
FVOCI_S3_SECRET_ACCESS_KEY=

# Profile mail (`--profile mail`): Mailpit keeps every mail fvoci sends.
# FVOCI_SMTP_HOST=mailpit
# FVOCI_SMTP_PORT=1025
# FVOCI_SMTP_TLS=none
# FVOCI_MAIL_FROM=fvoci@example.com
# A relay that asks to sign in (FVOCI_SMTP_PASSWORD is empty without one):
# FVOCI_SMTP_USER=
FVOCI_SMTP_PASSWORD=

# Mail through a provider's HTTP API instead of a relay (no FVOCI_SMTP_* then):
# FVOCI_MAIL_TRANSPORT=cloudflare, ses or oci, with FVOCI_MAIL_FROM, an address the
# provider lets this account send from, and that provider's lines below. The secrets of
# the providers not chosen stay empty.
# FVOCI_MAIL_TRANSPORT=
# Cloudflare Email Service: the account's ID, and an API token that may send mail.
# FVOCI_CLOUDFLARE_ACCOUNT_ID=
FVOCI_CLOUDFLARE_API_TOKEN=
# Amazon SES (API v2): the region, and the long-term key of an IAM user (AKIA...)
# that may ses:SendEmail.
# FVOCI_SES_REGION=us-east-1
# FVOCI_SES_ACCESS_KEY_ID=
FVOCI_SES_SECRET_ACCESS_KEY=
# OCI Email Delivery: the region, the OCIDs of the tenancy, the user and the approved
# sender's compartment, and the API key's fingerprint:
# FVOCI_OCI_REGION=us-ashburn-1
# FVOCI_OCI_TENANCY=ocid1.tenancy.oc1..
# FVOCI_OCI_USER=ocid1.user.oc1..
# FVOCI_OCI_COMPARTMENT=ocid1.compartment.oc1..
# FVOCI_OCI_FINGERPRINT=12:34:...
# and on the line below its private key (PEM without a passphrase) in double quotes,
# each of its lines ending in \n: "-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END...\n"
FVOCI_OCI_PRIVATE_KEY=
# Registration opens nothing until the link mailed to the address confirms it; fvoci
# does not start with it and no way of sending.
# FVOCI_EMAIL_VERIFICATION=false

# Profile tunnel (`--profile tunnel`): cloudflared brings requests from a Cloudflare
# Tunnel; its token, from the tunnel's page in Cloudflare's dashboard (empty without):
FVOCI_TUNNEL_TOKEN=
